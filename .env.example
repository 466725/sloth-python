# Application and analysis
STOCK_LIST=600519,300750,002594
REPORT_LANGUAGE=zh
SAVE_CONTEXT_SNAPSHOT=true
BACKTEST_ENABLED=true
BACKTEST_EVAL_WINDOW_DAYS=10
BACKTEST_MIN_AGE_DAYS=14
BACKTEST_ENGINE_VERSION=v1
BACKTEST_NEUTRAL_BAND_PCT=2.0
RUN_IMMEDIATELY=true
MARKET_REVIEW_ENABLED=true
DAILY_MARKET_CONTEXT_ENABLED=true
MAX_WORKERS=3

# Agent
AGENT_SKILLS=

# AI provider API keys (configure one or more)
# Enabled custom model channels also require an API key; see ai_stock/llm/llm-providers.md.
ANSPIRE_API_KEYS=sk-xxx
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Search providers
STOCK_INDEX_REMOTE_UPDATE_ENABLED=true
TAVILY_API_KEYS=
SERPAPI_API_KEYS=sk-xxx
BRAVE_API_KEYS=
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=true

# Email notifications
EMAIL_SENDER=64393733@qq.com
EMAIL_PASSWORD=xxx
EMAIL_RECEIVERS=weipeng.zheng.ca@gmail.com  # 可选，留空则发给自己
EMAIL_GROUP_1=weipeng.zheng.ca@gmail.com
SINGLE_STOCK_NOTIFY=false
STOCK_GROUP_1=600519,300750,601988

# Database
SLOTH_MYSQL_HOST=localhost
SLOTH_MYSQL_PORT=3306
SLOTH_MYSQL_DB=slothdb
SLOTH_MYSQL_USER=slothuser
SLOTH_MYSQL_PASSWORD=slothpass123
SLOTH_MYSQL_ROOT_PASSWORD=rootpass123
DATABASE_PATH=./ai_stock/stock_data/stock_analysis.db
# Docker Compose uses /app/data/stock_analysis.db instead; see the Docker guide
# before setting DOCKER_DATABASE_PATH to another mounted location.
# DOCKER_DATABASE_PATH=/app/data/stock_analysis.db
# Compose defaults to rollback journaling for Windows bind-mount compatibility.
# Enable only when the Docker database uses a filesystem with reliable WAL locking.
# DOCKER_SQLITE_WAL_ENABLED=true
SQLITE_WAL_ENABLED=true
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WRITE_RETRY_MAX=3
SQLITE_WRITE_RETRY_BASE_DELAY=0.1

# Web server and authentication
WEBUI_ENABLED=false
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000
WEBUI_AUTO_BUILD=true
ADMIN_AUTH_ENABLED=false

# Scheduling
SCHEDULE_ENABLED=false
SCHEDULE_TIME=18:00
SCHEDULE_RUN_IMMEDIATELY=true

# Logging and network
USE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=10809
LOG_DIR=./temps/logs
LOG_LEVEL=INFO
DEBUG=false

# AI-generation utility endpoints
DEEP_SEEK_URL=https://api.deepseek.com
OPENAI_URL=https://api.openai.com/v1

# UI and test settings
TANGERINE_URL=https://www.tangerine.ca/en/personal
UI_LOCALE=en-US
SLEEP_TIME=1
COOKIE_BANNER_TIMEOUT_SECONDS=5
PW_HEADLESS=false
