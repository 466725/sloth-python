# Copy this file to .env and set only the values you need.
# Keep real credentials in .env or a secret store; never commit them.
#
# See docs/llm-providers.md for provider/channel setup and docs/email_notifications.md
# for email setup. Most application settings have defaults and are omitted here.

# Analysis
STOCK_LIST=600519,300750,002594
REPORT_LANGUAGE=zh

# Optional AI provider credentials
# Configure one provider directly, or use LLM_CHANNELS for multiple providers.
# See docs/llm-providers.md for supported channel variables and examples.
# GEMINI_API_KEY=replace-with-your-key
# DEEPSEEK_API_KEY=replace-with-your-key
# OPENAI_API_KEY=replace-with-your-key
# LITELLM_MODEL=gemini/gemini-3.1-pro-preview
# LLM_CHANNELS=deepseek,gemini

# Optional search provider credentials
# TAVILY_API_KEYS=replace-with-your-key
# SERPAPI_API_KEYS=replace-with-your-key
# BRAVE_API_KEYS=replace-with-your-key

# Optional email notifications
# EMAIL_SENDER=sender@example.com
# EMAIL_PASSWORD=replace-with-your-smtp-app-password
# EMAIL_RECEIVERS=recipient@example.com
# EMAIL_SENDER_NAME=DSA

# Optional MySQL connection; SQLite is used when no MySQL settings are supplied.
# SLOTH_MYSQL_HOST=localhost
# SLOTH_MYSQL_PORT=3306
# SLOTH_MYSQL_DB=slothdb
# SLOTH_MYSQL_USER=slothuser
# SLOTH_MYSQL_PASSWORD=replace-with-a-local-password
# SLOTH_MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# Optional web server settings
# WEBUI_ENABLED=true
# WEBUI_HOST=127.0.0.1
# WEBUI_PORT=8000
# ADMIN_AUTH_ENABLED=true

# Optional UI automation settings
TANGERINE_URL=https://www.tangerine.ca/en/personal
UI_LOCALE=en-US
PW_HEADLESS=false
SLEEP_TIME=1
COOKIE_BANNER_TIMEOUT_SECONDS=5
