{
  "name": "dsa-web-playwright-tests",
  "version": "0.1.0",
  "description": "Playwright + TypeScript E2E test automation for the dsa-web application, with backend-authenticated smoke tests.",
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "test-automation",
    "smoke-tests"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=9"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "typescript": "~5.8.2"
  }
}
