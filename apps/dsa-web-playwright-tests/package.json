{
  "name": "dsa-web-playwright-tests",
  "version": "0.1.0",
  "description": "Playwright + TypeScript E2E test automation for the dsa-web application.",
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "test-automation",
    "smoke-tests"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=9"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "test:report": "playwright show-report ../../temps/dsa-web-ts-playwright/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2"
  }
}
