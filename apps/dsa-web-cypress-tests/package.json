{
  "name": "dsa-web-cypress-tests",
  "version": "0.1.0",
  "description": "Cypress + TypeScript UI test automation for the dsa-web application, using Page Object Model and Allure reporting.",
  "keywords": [
    "cypress",
    "typescript",
    "e2e",
    "test-automation",
    "page-object-model",
    "allure"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=9"
  },
  "scripts": {
    "cypress:open": "npx cypress open",
    "cypress:run": "npx cypress run",
    "test": "start-server-and-test test:serve http-get://127.0.0.1:4174 cypress:run",
    "test:serve": "npm --prefix ../dsa-web run dev -- --host 127.0.0.1 --port 4174 --strictPort",
    "allure:generate": "allure generate ../../temps/cypress_dsa_web/allure-results --clean -o ../../temps/cypress_dsa_web/allure-report",
    "allure:open": "allure open ../../temps/cypress_dsa_web/allure-report"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-cypress": "^3.13.0",
    "allure-js-commons": "^3.13.0",
    "cypress": "^16.1.1",
    "cypress-multi-reporters": "^2.0.5",
    "start-server-and-test": "^3.0.13",
    "typescript": "^7.0.2"
  }
}
